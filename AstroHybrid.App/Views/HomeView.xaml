<UserControl x:Class="AstroHybrid.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:app="clr-namespace:AstroHybrid.App"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             xmlns:models="clr-namespace:AstroHybrid.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <app:UpdateStateToVisibilityConverter x:Key="UpdateStateToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,16">
            <!-- Hero Section with Astro Bot Artwork -->
            <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Game Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="ASTRO BOT" Style="{StaticResource HeroTitleStyle}"/>
                        <TextBlock Text="Native PC Port • AstroHybrid" Style="{StaticResource HeroSubtitleStyle}" Margin="0,6,0,0"/>

                        <!-- Version Info Row -->
                        <WrapPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource VersionBadgeStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel>
                                        <TextBlock Text="INSTALLED" Style="{StaticResource VersionBadgeLabelStyle}"/>
                                        <TextBlock Text="{Binding GameVersionDisplay}" Style="{StaticResource VersionBadgeValueStyle}"
                                                   ToolTip="{Binding GameVersionDetails}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource VersionBadgeStyle}" Margin="8,0,0,0"
                                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🆕" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel>
                                        <TextBlock Text="AVAILABLE" Style="{StaticResource VersionBadgeLabelStyle}"/>
                                        <TextBlock Text="{Binding UpdateState.LatestUpdate.Version}" Style="{StaticResource VersionBadgeValueStyle}" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource VersionBadgeStyle}" Margin="8,0,0,0"
                                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SuccessBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="LATEST" Style="{StaticResource VersionBadgeLabelStyle}"/>
                                        <TextBlock Text="UP TO DATE" Style="{StaticResource VersionBadgeValueStyle}" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Status -->
                        <TextBlock Text="{Binding GameStatus}" Style="{StaticResource HeroStatusStyle}" Margin="0,8,0,0"
                                   Foreground="{Binding GameStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                    </StackPanel>

                    <!-- Right: Astro Bot Artwork -->
                    <Border Grid.Column="1" Width="130" Height="130" CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Grid>
                            <!-- Placeholder for Astro Bot artwork - replace with actual image when available -->
                            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" Opacity="0.15"/>
                            <Viewbox Margin="20" Stretch="Uniform">
                                <TextBlock Text="★" FontSize="120" Foreground="{StaticResource PrimaryBrush}" Opacity="0.6"/>
                            </Viewbox>
                            <TextBlock Text="ASTRO BOT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Quick Stats Grid -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="GAME VERSION" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding GameVersionDisplay}" Style="{StaticResource StatValueStyle}" FontSize="16" LineHeight="20"
                                   ToolTip="{Binding GameVersionDetails}"/>
                        <TextBlock Text="{Binding GameVersionNote}" Style="{StaticResource StatDetailStyle}"
                                   Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding HasGameVersionNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Style="{StaticResource StatDetailStyle}"><Run Text="Title ID: "/><Run Text="{Binding GameTitleId, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding CpuInfo}" Style="{StaticResource StatValueStyle}" FontSize="13" LineHeight="17"
                                   TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding CpuInfo}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding GpuInfo}" Style="{StaticResource StatValueStyle}" FontSize="13" LineHeight="17"
                                   TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding GpuInfo}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="RAM / DISPLAY" Style="{StaticResource StatLabelStyle}"/>
                        <WrapPanel Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding RamInfo}" Style="{StaticResource StatValueStyle}" FontSize="16" LineHeight="20"/>
                                <TextBlock Text="RAM" Style="{StaticResource StatDetailStyle}"/>
                            </StackPanel>
                            <TextBlock Text="|" Style="{StaticResource StatDetailStyle}" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayInfo}" Style="{StaticResource StatValueStyle}" FontSize="13" LineHeight="17"/>
                                <TextBlock Text="Display" Style="{StaticResource StatDetailStyle}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Current Graphics Configuration -->
            <Border Style="{StaticResource ConfigCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="CURRENT GRAPHICS CONFIGURATION" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                        <Button Content="Graphics Settings" Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right" FontSize="12" Padding="8,3"/>
                    </Grid>
                    <TextBlock Text="{Binding CurrentGraphicsConfig}" Style="{StaticResource ConfigTextStyle}" FontFamily="Consolas" FontSize="12"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                               ToolTip="{Binding CurrentGraphicsConfig}"/>
                </StackPanel>
            </Border>

            <!-- What's New / Release Notes Section (shown when update available) -->
            <Border Style="{StaticResource NewsCardStyle}" Margin="0,0,0,14"
                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="WHAT'S NEW IN" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding UpdateState.LatestUpdate.Version, StringFormat=' {0}'}" Style="{StaticResource SectionHeaderStyle}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    </Grid>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <TextBlock Text="{Binding UpdateState.LatestUpdate.ReleaseNotesDisplay}" Style="{StaticResource NewsTextStyle}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="View Full Release Notes" Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource TextButtonStyle}" FontSize="12" Padding="8,4"/>
                        <Button Content="Update Now" Command="{Binding DownloadUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" MinHeight="34" Padding="12,5" Margin="10,0,0,0"
                                FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Graphics Settings" Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" MinWidth="110" MinHeight="34" Padding="12,4"/>
                        <Button Content="{Binding RayTracingToggleText}" Command="{Binding ToggleRayTracingCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" MinWidth="95" MinHeight="34" Padding="12,4"
                                ToolTip="Click to toggle Ray Tracing between OFF (Non-RT faster lighting) and ON (Ray Tracing)"/>
                        <Button Content="Controller Settings" Command="{Binding NavigateToControllerCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" MinWidth="110" MinHeight="34" Padding="12,4"/>
                        <Button Content="Installation" Command="{Binding NavigateToInstallationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="95" MinHeight="34" Padding="12,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>