<Window x:Class="AstroHybrid.App.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroHybrid.App.Views"
        xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
        mc:Ignorable="d"
        Title="AstroHybrid Setup" Height="560" Width="640" MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/astrohybrid.ico">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BytesToStringConverter x:Key="BytesToStringConverter"/>
    </Window.Resources>


    <Grid Margin="24,12,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="AstroHybrid" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="Astro Bot Native PC Port Setup" Style="{StaticResource SubtitleTextStyle}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
            <StackPanel>
                <!-- Welcome Screen -->
                <StackPanel x:Name="WelcomePanel" Visibility="Visible">
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12">
                        Welcome to AstroHybrid! This setup wizard will help you prepare Astro Bot for Windows using your own legally obtained PS5 game dump.
                    </TextBlock>

                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8" FontWeight="SemiBold">
                        You will need:
                    </TextBlock>
                    <StackPanel Margin="16,0,0,14">
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,2">• A PS5 Astro Bot game dump (folder containing eboot.bin)</TextBlock>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,2">• Approximately 2-3 GB of free disk space</TextBlock>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,2">• NVIDIA RTX GPU recommended for DLSS/Frame Generation</TextBlock>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8">
                        The original game dump will never be modified. All files are created in a separate installation directory.
                    </TextBlock>
                </StackPanel>

                <!-- Game Selection -->
                <StackPanel x:Name="GameSelectionPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Select Game Dump" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8">
                        Browse to your Astro Bot PS5 game dump folder (the folder containing eboot.bin):
                    </TextBlock>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding GameDumpPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 MinHeight="36" Padding="10,6"
                                 ToolTip="Type or paste the dump folder, or use Browse"/>
                        <Button Grid.Column="1" Content="Browse..."
                                Command="{Binding BrowseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" MinWidth="84" MinHeight="36" Padding="12,5"/>
                    </Grid>

                    <TextBlock x:Name="ValidationErrorText"
                               Text="{Binding ValidationError}"
                               Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <!-- Game Info Preview -->
                    <Border x:Name="GameInfoBorder" Visibility="Collapsed" Style="{StaticResource PanelStyle}" Margin="0,8,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Detected Game Information" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Title ID: "/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{Binding GameInfo.TitleId}" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Version: "/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{Binding GameInfo.Version}" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Eboot Size: "/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Text="{Binding GameInfo.EbootSize, Converter={StaticResource BytesToStringConverter}}" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource MutedTextStyle}" Text="Status: "/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource SuccessBrush}" Text="Valid ✓"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Installation Progress -->
                <StackPanel x:Name="InstallPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Installing AstroHybrid" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding StatusMessage}" Margin="0,0,0,8"/>

                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                 Style="{StaticResource ModernProgressBarStyle}" Height="8"/>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0">
                        <Run Text="{Binding ProgressPercent}"/>% complete
                    </TextBlock>

                    <TextBlock x:Name="InstallErrorText"
                               Text="{Binding ValidationError}"
                               Style="{StaticResource ErrorTextStyle}"
                               Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Complete -->
                <StackPanel x:Name="CompletePanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource TitleTextStyle}" Foreground="{StaticResource SuccessBrush}" Text="✓ Setup Complete"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0">
                        AstroHybrid has been successfully installed. You can now configure your graphics and controller settings and launch the game.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" MinHeight="36" Padding="14,5"/>
            <Button x:Name="NextButton" Content="Check folder" Command="{Binding ValidateCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" MinHeight="36" Padding="14,5" Margin="8,0,0,0"/>
            <Button x:Name="InstallButton" Content="Install" Command="{Binding InstallCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" MinHeight="36" Padding="14,5" Margin="8,0,0,0"
                    Visibility="Collapsed" IsEnabled="{Binding CanProceed}"/>
            <Button x:Name="FinishButton" Content="Finish" Command="{Binding CancelCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" MinHeight="36" Padding="14,5" Margin="8,0,0,0"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>